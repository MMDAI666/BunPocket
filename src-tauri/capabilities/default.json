{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "deep-link:default",
    "fs:default",
    "fs:allow-copy-file",
    "fs:allow-rename",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        "$APPCONFIG/backups",
        "$APPCONFIG/backups/**",
        "$APPCONFIG/bunpocket.db",
        "$APPCONFIG/bunpocket.db.old",
        "$APPCONFIG/bunpocket.db-restore-tmp",
        "$APPCONFIG/bunpocket.db.pending-restore",
        "$APPCONFIG/bunpocket.db-journal",
        "$APPCONFIG/bunpocket.db-wal",
        "$APPCONFIG/bunpocket.db-shm"
      ]
    }
  ]
}
